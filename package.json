{
  "name": "@lv426/homebridge-systemair-enhanced",
  "displayName": "Systemair Ventilator",
  "version": "2.0.1",
  "description": "Systemair SAVE ventilation in HomeKit through SAVE Connect: modes for scenes (Refresh, Fireplace, Crowded, Away, Holiday) with their durations, the fan's real speed, temperature, humidity and the filter.",
  "main": "dist/index.js",
  "type": "commonjs",
  "files": [
    "dist",
    "config.schema.json",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build"
  },
  "author": "foxhoundn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foxhoundn/homebridge-systemair-enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/Foxhoundn/homebridge-systemair-enhanced/issues"
  },
  "homepage": "https://github.com/Foxhoundn/homebridge-systemair-enhanced#readme",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "systemair",
    "save-connect",
    "ventilation",
    "ventilator",
    "fan",
    "thermostat"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homebridge": {
    "pluginAlias": "SystemairVentilatorEnhanced",
    "pluginType": "accessory",
    "icon": "https://raw.githubusercontent.com/Foxhoundn/homebridge-systemair-enhanced/master/icon.png"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/node": "^26.6.5",
    "homebridge": "^2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
